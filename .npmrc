# =============================================================================
# npm 镜像：淘宝 npmmirror（替代已废弃的 npm.taobao.org）
# =============================================================================
# 首选地址（官方维护、同步快、全量包、国内 CDN、免费）
#   https://registry.npmmirror.com/
#
# 配置方式二选一（或同时使用，就近生效）：
#   1) 全局：Windows  C:\Users\<用户名>\.npmrc
#            Mac/Linux  ~/.npmrc
#   2) 项目：本文件位于仓库根目录，对本仓库及子目录（如 front/）的 npm 生效
#
# 测速：国内常见 10MB/s+，超时少。若必须用官方源，将 registry 改为：
#   https://registry.npmjs.org/
# =============================================================================

registry=https://registry.npmmirror.com/
