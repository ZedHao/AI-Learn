# 本地基座模型（4B/8B 等权重文件仅保留本机，不入库）
aiBaseModel/*
!aiBaseModel/.gitkeep

# 前端依赖与构建产物
front/node_modules/
front/dist/

# 后端虚拟环境
backServer/.venv/

# 根目录虚拟环境（若使用 uv/pip 在仓库根创建）
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.so

# 环境变量（避免泄露密钥）
.env
.env.*
!.env.example

# IDE 与系统文件
.idea/
.vscode/
*.swp
.DS_Store

# 日志与工具缓存
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
